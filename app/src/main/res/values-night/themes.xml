<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Nexus.Splash" parent="Theme.Nexus">
        <item name="windowSplashScreenBackground">@color/surface</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexus</item>
    </style>

    <style name="Theme.Nexus" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
