# SyncTouch Android Release Signing Configuration Template
# Copy this file to "SyncTouch-keystore/keystore.properties" and fill in your actual credentials.
# NOTE: Never commit "keystore.properties" or the *.jks/*.keystore file to version control.

# Path to the release keystore file, relative to project root
storeFile=SyncTouch-keystore/synctouch-release.jks

# Keystore password
storePassword=your_keystore_password_here

# Key alias
keyAlias=synctouch-release

# Key password
keyPassword=your_key_password_here
